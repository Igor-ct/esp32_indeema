menu "Custom LED Configuration"

config MY_LED_ENABLE
    bool "Enable LED control"
    default y
    help
        Enable or disable LED control logic in the application.

config MY_LED_GPIO
    int "LED GPIO Number"
    default 2
    range 0 48
    depends on MY_LED_ENABLE
    help
        GPIO pin number connected to the LED.
        Note: onboard LED GPIO varies by board; check your board schematic/pinout.

config MY_LED_ACTIVE_HIGH
    bool "LED is Active High"
    default y
    depends on MY_LED_ENABLE
    help
        Y: LED turns on when GPIO is high.
        N: LED turns on when GPIO is low.

endmenu